ROM_BASE			equ $000000
ROM_SIZE			equ $20000

; RAM CHIPS
BG_TILE_RC_BASE			equ $074000
BG_TILE_RC_SIZE			equ $2000
BG_TILE_RC_ADDR_LINES		equ 12
BG_TILE_RC_MASK			equ $ffff

FG_TILE_RC_BASE			equ $072000
FG_TILE_RC_SIZE			equ $2000
FG_TILE_RC_ADDR_LINES		equ 12
FG_TILE_RC_MASK			equ $ffff

PALETTE_RC_BASE			equ $078000
PALETTE_RC_SIZE			equ $2000
PALETTE_RC_ADDR_LINES		equ 12
PALETTE_RC_MASK			equ $0fff

; mame has the size as $2000, but if you try to accesss
; the upper $1000 the board will reboot/watchdog
SPRITE_RC_BASE			equ $076000
SPRITE_RC_SIZE			equ $1000
SPRITE_RC_ADDR_LINES		equ 11
SPRITE_RC_MASK			equ $ffff

TXT_TILE_RC_BASE		equ $070000
TXT_TILE_RC_SIZE		equ $1000
TXT_TILE_RC_ADDR_LINES		equ 11
TXT_TILE_RC_MASK		equ $ffff

WORK_RC_BASE			equ $060000
WORK_RC_SIZE			equ $4000
WORK_RC_ADDR_LINES		equ 13
WORK_RC_MASK			equ $ffff

; MEMORY REGIONS
BG_TILE_BASE			equ BG_TILE_RC_BASE
BG_TILE_SIZE			equ BG_TILE_RC_SIZE
BG_TILE_PALETTE_BASE		equ PALETTE_BASE + $600

FG_TILE_BASE			equ FG_TILE_RC_BASE
FG_TILE_SIZE			equ FG_TILE_RC_SIZE
FG_TILE_PALETTE_BASE		equ PALETTE_BASE + $400

PALETTE_BASE			equ PALETTE_RC_BASE
PALETTE_SIZE			equ PALETTE_RC_SIZE
PALETTE_ENTRY_SIZE		equ $20

SPRITE_BASE			equ SPRITE_RC_BASE
SPRITE_SIZE			equ SPRITE_RC_SIZE
SPRITE_PALETTE_BASE		equ PALETTE_BASE

TXT_TILE_BASE			equ TXT_TILE_RC_BASE
TXT_TILE_SIZE			equ TXT_TILE_RC_SIZE
TXT_TILE_PALETTE_BASE		equ PALETTE_BASE + $200

WORK_RAM_BASE			equ WORK_RC_BASE
WORK_RAM_SIZE			equ WORK_RC_SIZE


; REG/IO
REG_BG_TILE_OFFSET_X		equ $7a300
REG_BG_TILE_OFFSET_Y		equ $7a308
REG_BG_TILE_SCROLL_X		equ $7a30c
REG_BG_TILE_SCROLL_Y		equ $7a304

REG_FG_TILE_OFFSET_X		equ $7a200
REG_FG_TILE_OFFSET_Y		equ $7a208
REG_FG_TILE_SCROLL_X		equ $7a20c
REG_FG_TILE_SCROLL_Y		equ $7a204

REG_TXT_TILE_OFFSET_X		equ $7a100
REG_TXT_TILE_OFFSET_Y		equ $7a10c
REG_TXT_TILE_SCROLL_X		equ $7a10c
REG_TXT_TILE_SCROLL_Y		equ $7a104

REG_SOUND1			equ $07a803
REG_WATCHDOG			equ $07a800
REG_IRQ5_ACK			equ $07a806

REG_INPUT_DSW1			equ $07a005
REG_INPUT_DSW2			equ $07a004
REG_INPUT_P1			equ $07a003
REG_INPUT_P2			equ $07a002
REG_INPUT_SYSTEM		equ $07a001

CHAR_COLON			equ ' '

SOUND_NUM_STOP			equ $ff

	macro WATCHDOG
		move.w	d0, REG_WATCHDOG
	endm

	macro SOUND_PLAY
		move.b	d0, REG_SOUND1
	endm

	macro SOUND_STOP
		move.b	#SOUND_NUM_STOP, REG_SOUND1
	endm
