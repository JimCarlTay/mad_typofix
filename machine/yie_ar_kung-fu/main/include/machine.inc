ROM_BASE			equ $c000
ROM_SIZE			equ $4000

; RAM CHIPS
TILE_RC_BASE			equ $5800
TILE_RC_SIZE			equ $800
TILE_RC_ADDR_LINES		equ 11

; 2k chip, but a10 is tied to vcc
SPRITE1_RC_BASE			equ $5000
SPRITE1_RC_SIZE			equ $400
SPRITE1_RC_ADDR_LINES		equ 10

; 2k chip, but a10 is tied to vcc
WORK_RC_BASE			equ $5400
WORK_RC_SIZE			equ $400
WORK_RC_ADDR_LINES		equ 10

; MEMORY REGIONS
SPRITE1_BASE			equ SPRITE1_RC_BASE
SPRITE1_SIZE			equ $30

SPRITE2_BASE			equ WORK_RC_BASE
SPRITE2_SIZE			equ $30

TILE_BASE			equ TILE_RC_BASE
TILE_SIZE			equ $800

WORK_RAM_BASE			equ WORK_RC_BASE + $200
WORK_RAM_SIZE			equ $200

; REG/IO
REG_CONTROL			equ $4000
REG_WATCHDOG			equ $4f00

REG_SN76489A_DATA		equ $4800
REG_SN76489A_TRIGGER_LOAD	equ $4900

REG_VLM5030_CONTROL		equ $4a00
REG_VLM5030_DATA		equ $4b00
REG_VLM5030_STATUS		equ $0000

CTRL_NMI_DISABLE		equ $0
CTRL_NMI_ENABLE			equ $2
CTRL_IRQ_DISABLE		equ $0
CTRL_IRQ_ENABLE			equ $4

REG_INPUT_P1			equ $4e01
REG_INPUT_P2			equ $4e02
REG_INPUT_DSW1			equ $4e03
REG_INPUT_DSW2			equ $4c00
REG_INPUT_DSW3			equ $4d00
REG_INPUT_SYS			equ $4e00

CHAR_COLON			equ $10

	macro	WATCHDOG
		sta	REG_WATCHDOG
	endm

	macro	SOUND_PLAY
		sta	REG_VLM5030_DATA
		lda	#$1
		sta	REG_VLM5030_CONTROL
		lda	#$3
		sta	REG_VLM5030_CONTROL

	.\@:
		lda	#$1
		anda	REG_VLM5030_STATUS
		beq	.\@

		lda	#$1
		sta	REG_VLM5030_CONTROL
		clra
		sta	REG_VLM5030_CONTROL
	endm

	macro	SOUND_STOP
	endm
