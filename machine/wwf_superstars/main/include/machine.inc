ROM_BASE			equ $000000
ROM_SIZE			equ $40000

; RAM CHIPS
BG_TILE_RC_BASE			equ $0c0000
BG_TILE_RC_SIZE			equ $1000
BG_TILE_RC_ADDR_LINES		equ 12
BG_TILE_RC_MASK			equ $ff

FG_TILE_RC_BASE			equ $080000
FG_TILE_RC_SIZE			equ $1000
FG_TILE_RC_ADDR_LINES		equ 12
FG_TILE_RC_MASK			equ $ff

PALETTE_RC_BASE			equ $140000
	ifd _MAME_BUILD_
PALETTE_RC_SIZE			equ $300
PALETTE_RC_ADDR_LINES		equ 8
	else
PALETTE_RC_SIZE			equ $400
PALETTE_RC_ADDR_LINES		equ 10
	endif
PALETTE_RC_MASK			equ $fff

SPRITE_RC_BASE			equ $100000
SPRITE_RC_SIZE			equ $400
SPRITE_RC_ADDR_LINES		equ 10
SPRITE_RC_MASK			equ $ff

WORK_RC_BASE			equ $1c0000
WORK_RC_SIZE			equ $4000
WORK_RC_ADDR_LINES		equ 14
WORK_RC_MASK			equ $ffff

; MEMORY REGIONS
BG_TILE_BASE			equ BG_TILE_RC_BASE
BG_TILE_SIZE			equ BG_TILE_RC_SIZE
BG_TILE_PALETTE_BASE		equ PALETTE_BASE + $200

FG_TILE_BASE			equ FG_TILE_RC_BASE
FG_TILE_SIZE			equ FG_TILE_RC_SIZE
FG_TILE_PALETTE_BASE		equ PALETTE_BASE

PALETTE_BASE			equ PALETTE_RC_BASE
PALETTE_SIZE			equ PALETTE_RC_SIZE
PALETTE_ENTRY_SIZE		equ $20

SPRITE_BASE			equ SPRITE_RC_BASE
SPRITE_SIZE			equ SPRITE_RC_SIZE
SPRITE_PALETTE_BASE		equ PALETTE_BASE + $100

WORK_RAM_BASE			equ WORK_RC_BASE
WORK_RAM_SIZE			equ WORK_RC_SIZE

; REG/IO
REG_SOUND			equ $180009
REG_IRQ5_ACK			equ $180002
REG_IRQ6_ACK			equ $180000
REG_SCROLL_X			equ $180004
REG_SCROLL_Y			equ $180006

REG_INPUT_P1			equ $180005
REG_INPUT_P2			equ $180007
REG_INPUT_DSW1			equ $180001
REG_INPUT_DSW2			equ $180003
REG_INPUT_SYSTEM		equ $180009

SYS_VBLANK_BIT			equ $0
SYS_VBLANK			equ $01

DSW1_FLIP_SCREEN_BIT		equ $7
DSW1_FLIP_SCREEN		equ $80

CHAR_COLON			equ ':'

SOUND_NUM_STOP			equ $00

	macro WATCHDOG
	endm

	macro SOUND_PLAY
		move.b	d0, REG_SOUND
	endm

	macro SOUND_STOP
		move.b	#SOUND_NUM_STOP, REG_SOUND
	endm
