ROM_BASE			equ $8000
ROM_SIZE			equ $8000

; RAM CHIPS
PALETTE_RC_BASE			equ $0800
PALETTE_RC_SIZE			equ $400
PALETTE_RC_ADDR_LINES		equ 10

WORK_RC_BASE			equ $3000
WORK_RC_SIZE			equ $1000
WORK_RC_ADDR_LINES		equ 12

K007121_RC_BASE			equ $1000
K007121_RC_SIZE			equ $2000
K007121_RC_ADDR_LINES		equ 13

; MEMORY REGIONS
LAYER_A_TILE_BASE		equ K007121_RC_BASE + $1400
LAYER_A_TILE_SIZE		equ $400
LAYER_A_TILE_PALETTE_BASE	equ PALETTE_BASE + $200

LAYER_A_TILE_ATTR_BASE		equ K007121_RC_BASE + $1000
LAYER_A_TILE_ATTR_SIZE		equ $400

; top 5 lines
LAYER_B_TILE_BASE		equ K007121_RC_BASE + $1c00
LAYER_B_TILE_SIZE		equ $400
LAYER_B_TILE_PALETTE_BASE	equ PALETTE_BASE + $200

LAYER_B_TILE_ATTR_BASE		equ K007121_RC_BASE + $1800
LAYER_B_TILE_ATTR_SIZE		equ $400

PALETTE_BASE			equ PALETTE_RC_BASE
PALETTE_SIZE			equ PALETTE_RC_SIZE
PALETTE_ENTRY_SIZE		equ $20

SPRITE_BASE			equ K007121_RC_BASE
SPRITE_SIZE			equ $1000
SPRITE_PALETTE_BASE		equ PALETTE_BASE

WORK_RAM_BASE			equ WORK_RC_BASE
WORK_RAM_SIZE			equ WORK_RC_SIZE

; REG/IO
; note x/y swapped because of tate screen
REG_LAYER_A_TILE_SCROLL_Y	equ $0000
REG_LAYER_A_TILE_SCROLL_Y_HI	equ $0001
REG_LAYER_A_TILE_SCROLL_X	equ $0002
REG_K007121_C3			equ $0003
REG_K007121_C4			equ $0004

REG_WATCHDOG			equ $041c
REG_SOUND			equ $0414
REG_SOUND_IRQ_TRIGGER		equ $0418
REG_CONTROL			equ $0410

REG_INPUT_P1			equ $0400
REG_INPUT_P2			equ $0401
REG_INPUT_DSW1			equ $0407
REG_INPUT_DSW2			equ $0406
REG_INPUT_DSW3			equ $0402
REG_INPUT_SYSTEM		equ $0403

CHAR_COLON			equ $10

	macro	WATCHDOG
		sta	REG_WATCHDOG
	endm

	macro	SOUND_PLAY
		sta	REG_SOUND
		sta	REG_SOUND_IRQ_TRIGGER
	endm

	macro	SOUND_STOP
		clr	REG_SOUND
		sta	REG_SOUND_IRQ_TRIGGER
	endm
