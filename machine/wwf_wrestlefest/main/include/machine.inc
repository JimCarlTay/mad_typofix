ROM_BASE			equ $000000
	ifd _27C010_
ROM_SIZE			equ $40000
	else
ROM_SIZE			equ $80000
	endif

; RAM CHIPS
PALETTE_RC_BASE			equ $180000
PALETTE_RC_SIZE			equ $10000	; address space, not size (2k)
PALETTE_RC_ADDR_LINES		equ 16
PALETTE_RC_MASK			equ $ffff

TILE_RC_BASE			equ $080000
TILE_RC_SIZE			equ $4000
TILE_RC_ADDR_LINES		equ 14
TILE_RC_MASK			equ $ffff

TXT_TILE_SPRITE_RC_BASE		equ $0c0000
TXT_TILE_SPRITE_RC_SIZE		equ $4000
TXT_TILE_SPRITE_RC_ADDR_LINES	equ 14
TXT_TILE_SPRITE_RC_MASK		equ $ff

WORK_RC_BASE			equ $1c0000
WORK_RC_SIZE			equ $4000
WORK_RC_ADDR_LINES		equ 14
WORK_RC_MASK			equ $ffff

; MEMORY REGIONS
PALETTE_BASE			equ PALETTE_RC_BASE
PALETTE_SIZE			equ PALETTE_RC_SIZE
PALETTE_ENTRY_SIZE		equ $80

LAYER_A_TILE_BASE		equ TILE_RC_BASE
LAYER_A_TILE_SIZE		equ $1000
LAYER_A_TILE_PALETTE_BASE	equ PALETTE_BASE + $8000

LAYER_B_TILE_BASE		equ TILE_RC_BASE + $2000
LAYER_B_TILE_SIZE		equ $1000
LAYER_B_TILE_PALETTE_BASE	equ PALETTE_BASE + $6000

SPRITE_BASE			equ TXT_TILE_SPRITE_RC_BASE + $2000
SPRITE_SIZE			equ $2000
SPRITE_PALETTE_BASE		equ PALETTE_BASE + $2000

TXT_TILE_BASE			equ TXT_TILE_SPRITE_RC_BASE
TXT_TILE_SIZE			equ $2000
TXT_TILE_PALETTE_BASE		equ PALETTE_BASE

WORK_RAM_BASE			equ WORK_RC_BASE
WORK_RAM_SIZE			equ WORK_RC_SIZE

; REG/IO
REG_LAYER_A_TILE_SCROLL_X	equ $100000
REG_LAYER_A_TILE_SCROLL_Y	equ $100002

REG_LAYER_B_TILE_SCROLL_X	equ $100004
REG_LAYER_B_TILE_SCROLL_Y	equ $100006

REG_SOUND			equ $14000d
REG_SCREEN_PRIORITY		equ $140011
REG_IRQ2_ACK			equ $140002
REG_IRQ3_ACK			equ $140000
REG_SPRITE_COPY			equ $140008
REG_WATCHDOG			equ $140016

REG_INPUT_P1			equ $140021
REG_INPUT_P2			equ $140023
REG_INPUT_P3			equ $140025
REG_INPUT_P4			equ $140027
REG_INPUT_DSW1			equ $140020
REG_INPUT_DSW2			equ $140022
REG_INPUT_DSW3			equ $140024
REG_INPUT_SYSTEM		equ $140026

SYS_VBLANK_BIT			equ $2
SYS_VBLANK			equ $04

CHAR_COLON			equ '@'

SOUND_NUM_STOP			equ $00

	macro WATCHDOG
		clr.w	REG_WATCHDOG
	endm

	macro SOUND_PLAY
		move.b	d0, REG_SOUND
	endm

	macro SOUND_STOP
		move.b	#SOUND_NUM_STOP, REG_SOUND
	endm
