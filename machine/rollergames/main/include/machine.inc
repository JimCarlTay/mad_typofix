ROM_BASE			equ $8000
ROM_SIZE			equ $8000

; RAM CHIPS
PALETTE_RC_BASE			equ $1800
PALETTE_RC_SIZE			equ $800
PALETTE_RC_ADDR_LINES		equ 11

SPRITE_RC_BASE			equ $1000
SPRITE_RC_SIZE			equ $800
SPRITE_RC_ADDR_LINES		equ 11

TILE_RC_BASE			equ $800
TILE_RC_SIZE			equ $800
TILE_RC_ADDR_LINES		equ 11

WORK_RC_BASE			equ $2000
WORK_RC_SIZE			equ $1b00
WORK_RC_ADDR_LINES		equ 12

; MEMORY REGIONS
PALETTE_BASE			equ PALETTE_RC_BASE
PALETTE_SIZE			equ PALETTE_RC_SIZE
PALETTE_ENTRY_SIZE		equ $20

SPRITE_BASE			equ $1000
SPRITE_SIZE			equ $800
SPRITE_PALETTE_BASE		equ PALETTE_BASE + $200

TILE_BASE			equ TILE_RC_BASE
TILE_SIZE			equ $400
TILE_PALETTE_BASE		equ PALETTE_BASE

TILE_ATTR_BASE			equ TILE_RC_BASE + $400
TILE_ATTR_SIZE			equ $400

WORK_RAM_BASE			equ WORK_RC_BASE
WORK_RAM_SIZE			equ WORK_RC_SIZE

; REG/IO
REG_INPUT_P1			equ $0050
REG_INPUT_P2			equ $0051
REG_INPUT_DSW1			equ $0053
REG_INPUT_DSW2			equ $0060
REG_INPUT_DSW3			equ $0053

REG_WATCHDOG			equ $0020
REG_SOUND			equ $0030
REG_SOUND_IRQ_TRIGGER		equ $0040
REG_SPRITE_REFRESH		equ $0306

CHAR_COLON			equ $10		; no colon char, using space

	macro	WATCHDOG
		tst	>REG_WATCHDOG
	endm

	macro	SOUND_PLAY
		sta	REG_SOUND
		clr	REG_SOUND + 1
		sta	REG_SOUND_IRQ_TRIGGER
	endm

	macro	SOUND_STOP
		clr	REG_SOUND
		clr	REG_SOUND + 1
		sta	REG_SOUND_IRQ_TRIGGER
	endm
