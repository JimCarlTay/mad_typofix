ROM_BASE			equ $000000
ROM_SIZE			equ $20000

; RAM CHIPS
BG_TILE_RC_BASE			equ $f4000
BG_TILE_RC_SIZE			equ $4000
BG_TILE_RC_ADDR_LINES		equ 14
BG_TILE_RC_MASK			equ $ff

FG_TILE_RC_BASE			equ $f0000
FG_TILE_RC_SIZE			equ $4000
FG_TILE_RC_ADDR_LINES		equ 14
FG_TILE_RC_MASK			equ $ff

PALETTE_RC_BASE			equ $f8000
PALETTE_RC_SIZE			equ $800
PALETTE_RC_ADDR_LINES		equ 11
PALETTE_RC_MASK			equ $ffff

SPRITE_RC_BASE			equ $e0000
SPRITE_RC_SIZE			equ $1000
SPRITE_RC_ADDR_LINES		equ 12
SPRITE_RC_MASK			equ $ffff

TXT_TILE_RC_BASE		equ $ec000
TXT_TILE_RC_SIZE		equ $1000
TXT_TILE_RC_ADDR_LINES		equ 12
TXT_TILE_RC_MASK		equ $ff

WORK_RC_BASE			equ $fc000
WORK_RC_SIZE			equ $4000
WORK_RC_ADDR_LINES		equ 14
WORK_RC_MASK			equ $ffff

; MEMORY REGIONS
BG_TILE_BASE			equ BG_TILE_RC_BASE
BG_TILE_SIZE			equ BG_TILE_RC_SIZE
BG_TILE_PALETTE_BASE		equ PALETTE_BASE
BG_TILE_PALETTE_ENTRY_SIZE	equ $20

FG_TILE_BASE			equ FG_TILE_RC_BASE
FG_TILE_SIZE			equ FG_TILE_RC_SIZE
FG_TILE_PALETTE_BASE		equ PALETTE_BASE + $200
FG_TILE_PALETTE_ENTRY_SIZE	equ $20

PALETTE_BASE			equ PALETTE_RC_BASE
PALETTE_SIZE			equ PALETTE_RC_SIZE

; sprirt ram is $1000 size, but sprite data
; starts at +$800 offset
SPRITE_BASE			equ SPRITE_RC_BASE + $800
SPRITE_SIZE			equ $800
SPRITE_PALETTE_BASE		equ PALETTE_BASE + $400
SPRITE_PALETTE_ENTRY_SIZE	equ $20

TXT_TILE_BASE			equ TXT_TILE_RC_BASE
TXT_TILE_SIZE			equ $800
TXT_TILE_PALETTE_BASE		equ PALETTE_BASE + $600
TXT_TILE_PALETTE_ENTRY_SIZE	equ $8

TXT_TILE_ATTR_BASE		equ TXT_TILE_RC_BASE + $800
TXT_TILE_ATTR_SIZE		equ $800

WORK_RAM_BASE			equ WORK_RC_BASE
WORK_RAM_SIZE			equ WORK_RC_SIZE

; REG/IO
REG_SOUND			equ $e4002
REG_FG_TILE_SCROLL_X		equ $e8010
REG_FG_TILE_SCROLL_Y		equ $e8012
REG_BG_TILE_SCROLL_X		equ $e8014
REG_BG_TILE_SCROLL_Y		equ $e8016
REG_SPRITE_COPY_REQUEST		equ $e8018

REG_INPUT_DSW1			equ $e4003
REG_INPUT_DSW2			equ $e4002
REG_INPUT_P12			equ $e4000

CHAR_COLON			equ $3a

SOUND_NUM_STOP			equ $ff

	macro WATCHDOG
	endm

	macro SOUND_PLAY
	endm

	macro SOUND_STOP
	endm
