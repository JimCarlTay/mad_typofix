ROM_BASE			equ $c000
ROM_SIZE			equ $4000

; RAM CHIPS
; everything is on this ram chip
WORK_RC_BASE			equ $2000
WORK_RC_SIZE			equ $2000
WORK_RC_ADDR_LINES		equ 13

; MEMORY REGIONS
LAYER_A_TILE_BASE		equ WORK_RC_BASE + $400
LAYER_A_TILE_SIZE		equ $400

LAYER_A_TILE_ATTR_BASE		equ WORK_RC_BASE
LAYER_A_TILE_ATTR_SIZE		equ $400

; top 5 lines
LAYER_B_TILE_BASE		equ WORK_RC_BASE + $c00
LAYER_B_TILE_SIZE		equ $400

LAYER_B_TILE_ATTR_BASE		equ WORK_RC_BASE + $800
LAYER_B_TILE_ATTR_SIZE		equ $400

SPRITE_BASE			equ WORK_RC_BASE + $1000
SPRITE_SIZE			equ $200

WORK_RAM_BASE			equ WORK_RC_BASE + $1a00
WORK_RAM_SIZE			equ $600

; REG/IO
REG_VIDEO			equ $0003
REG_CONTROL			equ $0004
REG_WATCHDOG			equ $0818

REG_LAYER_B_TILE_SCROLL_X	equ $0001
REG_LAYER_B_TILE_SCROLL_Y	equ $0000

REG_SN76489A_DATA		equ $081b
REG_SN76489A_TRIGGER_LOAD	equ $081a

REG_M58715			equ $081d
REG_M58715_IRQ_TRIGGER		equ $081c

CTRL_NMI_DISABLE		equ $0
CTRL_NMI_ENABLE			equ $1
CTRL_IRQ_DISABLE		equ $0
CTRL_IRQ_ENABLE			equ $2
CTRL_FIRQ_DISABLE		equ $0
CTRL_FIRQ_ENABLE		equ $4

VID_UNKNOWN_BIT2		equ $4

REG_INPUT_P1			equ $0811
REG_INPUT_P2			equ $0812
REG_INPUT_DSW1			equ $0813
REG_INPUT_DSW2			equ $0808
REG_INPUT_DSW3			equ $0800
REG_INPUT_SYS			equ $0810

CHAR_COLON			equ $10

	macro	WATCHDOG
		sta	REG_WATCHDOG
	endm

	macro	SOUND_PLAY
		sta	REG_M58715
		sta	REG_M58715_IRQ_TRIGGER
	endm

	macro	SOUND_STOP
		clra
		sta	REG_M58715
		sta	REG_M58715_IRQ_TRIGGER
	endm
