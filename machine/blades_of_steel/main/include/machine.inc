ROM_BASE			equ $8000
ROM_SIZE			equ $8000

K007342_BASE			equ $0000

; RAM CHIPS
PALETTE_RC_BASE			equ $2400
PALETTE_RC_SIZE			equ $60
PALETTE_RC_ADDR_LINES		equ 6

SPRITE_RC_BASE			equ $2000
SPRITE_RC_SIZE			equ $200
SPRITE_RC_ADDR_LINES		equ $9

WORK_RC_BASE			equ $4000
WORK_RC_SIZE			equ $2000
WORK_RC_ADDR_LINES		equ 13

TILE_RC_BASE			equ $0000
TILE_RC_SIZE			equ $2000
TILE_RC_ADDR_LINES		equ 13

; MEMORY REGIONS
LAYER_A_TILE_BASE		equ K007342_BASE + $800
LAYER_A_TILE_SIZE		equ $800
LAYER_A_TILE_PALETTE_BASE	equ PALETTE_BASE

LAYER_A_TILE_ATTR_BASE		equ K007342_BASE
LAYER_A_TILE_ATTR_SIZE		equ $800

LAYER_A_TILE_SCROLL_BASE	equ K007342_BASE + $2200
LAYER_A_TILE_SCROLL_SIZE	equ $200

LAYER_B_TILE_BASE		equ K007342_BASE + $1800
LAYER_B_TILE_SIZE		equ $800
LAYER_B_TILE_PALETTE_BASE	equ PALETTE_BASE + PALETTE_ENTRY_SIZE

LAYER_B_TILE_ATTR_BASE		equ K007342_BASE + $1000
LAYER_B_TILE_ATTR_SIZE		equ $800

PALETTE_BASE			equ PALETTE_RC_BASE
PALETTE_SIZE			equ PALETTE_RC_SIZE
PALETTE_ENTRY_SIZE		equ $20

SPRITE_BASE			equ SPRITE_RC_BASE
SPRITE_SIZE			equ SPRITE_RC_SIZE
SPRITE_PALETTE_BASE		equ PALETTE_BASE + $40

WORK_RAM_BASE			equ WORK_RC_BASE
WORK_RAM_SIZE			equ WORK_RC_SIZE

; REG/IO
; K007342 registers
; Note: x/y are swapped because screen is tate
REG_LAYER_SCROLL_Y_HI		equ $2602
REG_LAYER_A_SCROLL_Y		equ $2603
REG_LAYER_A_SCROLL_X		equ $2604
REG_LAYER_B_SCROLL_Y		equ $2605
REG_LAYER_B_SCROLL_X		equ $2606

K051733_BASE			equ $2f80

REG_WATCHDOG			equ $2ec0
REG_CONTROL			equ $2f40
REG_SOUND			equ $2e80

REG_INPUT_P1			equ $2e01
REG_INPUT_P2			equ $2e02
REG_INPUT_DSW1			equ $2e40
REG_INPUT_DSW2			equ $2e03
REG_INPUT_DSW3			equ $2e00

CHAR_COLON			equ $10

	macro	WATCHDOG
		sta	REG_WATCHDOG
	endm

	macro	SOUND_PLAY
		sta	REG_SOUND
	endm

	macro	SOUND_STOP
		clr	REG_SOUND
	endm
