	include "cps_a.inc"
	include "cps_b.inc"
	include "romset.inc"

ROM_BASE			equ $0
ROM_SIZE			equ $20000

; RAM CHIPS
OBJECT_RC_BASE			equ $708000
OBJECT_RC_SIZE			equ $2000
OBJECT_RC_ADDR_LINES		equ 12
OBJECT_RC_MASK			equ $ffff

GFX_RC_BASE			equ $900000
GFX_RC_SIZE			equ $30000
GFX_RC_ADDR_LINES		equ 17
GFX_RC_MASK			equ $ffff

QSOUND_RC_BASE			equ $618000
; Avoid conflict with sound cpu
; QSOUND_RAM_SIZE		equ $2000
QSOUND_RC_SIZE			equ $1e80
QSOUND_RC_ADDR_LINES		equ 9
QSOUND_RC_MASK			equ $ff

WORK_RC_BASE			equ $ff0000
; limiting size here because suicided boards
; have stuff mapped to 0xfffff0 to 0xfffffb
WORK_RC_SIZE			equ $fff0
WORK_RC_ADDR_LINES		equ 16
WORK_RC_MASK			equ $ffff

; MEMORY REGIONS
OBJECT_BASE			equ OBJECT_RC_BASE
OBJECT_SIZE			equ OBJECT_RC_SIZE
OBJECT_PALETTE_BASE		equ PALETTE_BASE

PALETTE_BASE			equ GFX_RC_BASE
PALETTE_SIZE			equ $4000
PALETTE_ENTRY_SIZE		equ $20

QSOUND_BASE			equ QSOUND_RC_BASE
QSOUND_SIZE			equ QSOUND_RC_SIZE

SCROLL1_BASE			equ GFX_RC_BASE + $c000
SCROLL1_SIZE			equ $4000
SCROLL1_PALETTE_BASE		equ PALETTE_BASE + $400

SCROLL2_BASE			equ GFX_RC_BASE + $4000
SCROLL2_SIZE			equ $4000
SCROLL2_PALETTE_BASE		equ PALETTE_BASE + $800

SCROLL3_BASE			equ GFX_RC_BASE + $8000
SCROLL3_SIZE			equ $4000
SCROLL3_PALETTE_BASE		equ PALETTE_BASE + $c00

ROW_SCROLL_BASE			equ GFX_RC_BASE + $20000
ROW_SCROLL_SIZE			equ $4000

WORK_RAM_BASE			equ WORK_RC_BASE
WORK_RAM_SIZE			equ WORK_RC_SIZE

; REG/IO
REG_SOUND1			equ $800181
REG_SOUND2			equ $800189
REG_COIN_CTRL			equ $800030
REG_EEPROM_PORT			equ $804040
REG_OBJECT_RAM_BANK		equ $8040e1

REG_INPUT_P1			equ $804001
REG_INPUT_P2			equ $804000
REG_INPUT_P3			equ $804011
REG_INPUT_P4			equ $804010
REG_INPUT_SYSTEM1		equ $804021
REG_INPUT_SYSTEM2		equ $804020

CHAR_COLON			equ ':'

	macro SOUND_INIT
		move.b	#$88, $619ffb
		move.b	#$ff, $619ffd
		move.b	#$ff, $619fff
		SOUND_STOP
	endm

	macro SOUND_PLAY
		move.b	d0, $618003
		lsr.w	#$8, d0
		move.b	d0, $618001
		move.b	#$0, $61801f
	endm

	macro SOUND_STOP
		move.b	#$ff, $618001
		move.b	#$0, $618003
		move.b	#$0, $61801f
	endm
