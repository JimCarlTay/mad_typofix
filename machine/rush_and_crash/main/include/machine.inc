ROM_BASE			equ $c000
ROM_SIZE			equ $4000

; RAM CHIPS
BG_TILE_RC_BASE			equ $2000
BG_TILE_RC_SIZE			equ $2000
BG_TILE_RC_ADDR_LINES		equ 13

; write-only
PALETTE_RC_BASE			equ $7000
PALETTE_RC_SIZE			equ $400	; might actually be $1000

; write-only
TXT_TILE_RC_BASE		equ $5000
TXT_TILE_RC_SIZE		equ $2000

WORK_RC_BASE			equ $0000
WORK_RC_SIZE			equ $2000
WORK_RC_ADDR_LINES		equ 13

; MEMORY REGIONS
BG_TILE_BASE			equ BG_TILE_RC_BASE
BG_TILE_SIZE			equ BG_TILE_RC_SIZE
BG_TILE_PALETTE_BASE		equ PALETTE_BASE + $100
BG_TILE_PALETTE_ENTRY_SIZE	equ $20

PALETTE_BASE			equ PALETTE_RC_BASE
PALETTE_SIZE			equ PALETTE_RC_SIZE

SPRITE_BASE			equ WORK_RC_BASE + $1e00
SPRITE_SIZE			equ $200
SPRITE_PALETTE_BASE		equ PALETTE_BASE + $200
SPRITE_PALETTE_ENTRY_SIZE	equ $20

TXT_TILE_BASE			equ TXT_TILE_RC_BASE
TXT_TILE_SIZE			equ TXT_TILE_RC_SIZE
TXT_TILE_PALETTE_BASE		equ PALETTE_BASE + $380
TXT_TILE_PALETTE_ENTRY_SIZE	equ $8

WORK_RAM_BASE			equ WORK_RC_BASE
WORK_RAM_SIZE			equ $1000

; REG/IO
REG_BG_TILE_SCROLL_X		equ $400a
REG_BG_TILE_SCROLL_Y		equ $400c

REG_BANK			equ $4008
REG_CONTROL			equ $4009
REG_SOUND			equ $400e

REG_INPUT_P1			equ $4009
REG_INPUT_P2			equ $400a
REG_INPUT_DSW1			equ $400b
REG_INPUT_DSW2			equ $400c
REG_INPUT_SYS			equ $4008

CHAR_COLON			equ $20

	macro	WATCHDOG
	endm

	macro	SOUND_PLAY
		tfr	d, y

		lda	#$00
		sta	REG_SOUND

		DELAY	#$1ff


		lda	#$fe
		sta	REG_SOUND

		DELAY	#$1ff

		tfr	y, d
		sta	REG_SOUND

	endm

	macro	SOUND_STOP
		lda	#$00
		sta	REG_SOUND

		DELAY	#$1ff

		lda	#$fe
		sta	REG_SOUND
	endm

