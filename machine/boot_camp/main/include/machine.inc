ROM_BASE				equ $8000
ROM_SIZE				equ $8000

; RAM CHIPS
PALETTE_RC_BASE				equ $0600
PALETTE_RC_SIZE				equ $100
PALETTE_RC_ADDR_LINES			equ 8

WORK_RC_BASE				equ $0800
WORK_RC_SIZE				equ $800
WORK_RC_ADDR_LINES			equ 11

K007121_G8_RC_BASE			equ $2000
K007121_G8_RC_SIZE			equ $2000
K007121_G8_RC_ADDR_LINES		equ 13

; same address space as G8, REG_CONTROL is used
; to swap between them
K007121_G15_RC_BASE			equ $2000
K007121_G15_RC_SIZE			equ $2000
K007121_G15_RC_ADDR_LINES		equ 13

; MEMORY REGIONS
; bg2
K007121_G8_LAYER_A_TILE_BASE		equ K007121_G8_RC_BASE + $400
K007121_G8_LAYER_A_TILE_SIZE		equ $400
K007121_G8_LAYER_A_TILE_PALETTE_BASE	equ PALETTE_BASE + $a0

K007121_G8_LAYER_A_TILE_ATTR_BASE	equ K007121_G8_RC_BASE
K007121_G8_LAYER_A_TILE_ATTR_SIZE	equ $400

; not used
K007121_G8_LAYER_B_TILE_BASE		equ K007121_G8_RC_BASE + $c00
K007121_G8_LAYER_B_TILE_SIZE		equ $400
K007121_G8_LAYER_B_TILE_PALETTE_BASE	equ PALETTE_BASE + $a0

K007121_G8_LAYER_B_TILE_ATTR_BASE	equ K007121_G8_RC_BASE + $800
K007121_G8_LAYER_B_TILE_ATTR_SIZE	equ $400

K007121_G8_SPRITE_BASE			equ K007121_G8_RC_BASE + $1800
K007121_G8_SPRITE_SIZE			equ $1000
K007121_G8_SPRITE_PALETTE_BASE		equ PALETTE_BASE + $80

; txt (line >= 5)
K007121_G15_LAYER_A_TILE_BASE		equ K007121_G15_RC_BASE + $400
K007121_G15_LAYER_A_TILE_SIZE		equ $400
K007121_G15_LAYER_A_TILE_PALETTE_BASE	equ PALETTE_BASE + $20

K007121_G15_LAYER_A_TILE_ATTR_BASE	equ K007121_G15_RC_BASE
K007121_G15_LAYER_A_TILE_ATTR_SIZE	equ $400

; txt / hdr (line < 5)
K007121_G15_LAYER_B_TILE_BASE		equ K007121_G15_RC_BASE + $c00
K007121_G15_LAYER_B_TILE_SIZE		equ $400
K007121_G15_LAYER_B_TILE_PALETTE_BASE	equ PALETTE_BASE + $20

K007121_G15_LAYER_B_TILE_ATTR_BASE	equ K007121_G15_RC_BASE + $800
K007121_G15_LAYER_B_TILE_ATTR_SIZE	equ $400

K007121_G15_SPRITE_BASE			equ K007121_G15_RC_BASE + $1800
K007121_G15_SPRITE_SIZE			equ $1000
K007121_G15_SPRITE_PALETTE_BASE		equ PALETTE_BASE


PALETTE_BASE				equ PALETTE_RC_BASE
PALETTE_SIZE				equ PALETTE_RC_SIZE
PALETTE_ENTRY_SIZE			equ $20

WORK_RAM_BASE				equ WORK_RC_BASE
WORK_RAM_SIZE				equ WORK_RC_SIZE

; REG/IO
; note x/y swapped because of tate screen
REG_K007121_G8_SCROLL_Y			equ $0060
REG_K007121_G8_SCROLL_Y_HI		equ $0001
REG_K007121_G8_SCROLL_X			equ $0002
REG_K007121_G8_C3			equ $0003

REG_K007121_G15_SCROLL_Y		equ $0000
REG_K007121_G15_SCROLL_Y_HI		equ $0001
REG_K007121_G15_SCROLL_X		equ $0002
REG_K007121_G15_C3			equ $0003

REG_WATCHDOG				equ $041c
REG_SOUND				equ $0414
REG_SOUND_IRQ_TRIGGER			equ $0418
REG_CONTROL				equ $0410

REG_CTRL_K007121_G15			equ $00
REG_CTRL_K007121_G8			equ $40

REG_INPUT_P1				equ $0400
REG_INPUT_P1_TB_X			equ $0405
REG_INPUT_P1_TB_Y			equ $0404
REG_INPUT_P2				equ $0401
REG_INPUT_P2_TB_X			equ $0407
REG_INPUT_P2_TB_Y			equ $0406
REG_INPUT_DSW1				equ $0402
REG_INPUT_DSW2				equ $0403
REG_INPUT_DSW3				equ $0401

CHAR_COLON				equ $40

	macro	WATCHDOG
		sta	REG_WATCHDOG
	endm

	macro	SOUND_PLAY
		sta	REG_SOUND
		sta	REG_SOUND_IRQ_TRIGGER
	endm

	macro	SOUND_STOP
		clr	REG_SOUND
		sta	REG_SOUND_IRQ_TRIGGER
	endm
